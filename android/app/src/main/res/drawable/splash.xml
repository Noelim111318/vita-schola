<?xml version="1.0" encoding="utf-8"?>
<!-- Fond de lancement (avant Android 12, et fond de fenetre ensuite) : bleu nuit de l'icone
     + monogramme centre, a la place de l'image Capacitor par defaut (blanc + logo Capacitor). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap android:gravity="center" android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
